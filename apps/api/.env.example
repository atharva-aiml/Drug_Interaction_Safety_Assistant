PORT=4000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword123
JWT_SECRET=change-me-in-real-deployment

# Groq (OpenAI-compatible) — one or more free-tier API keys, comma-separated.
# Get keys at https://console.groq.com. Never commit real keys — put them in
# .env (gitignored), not here.
GROQ_API_KEYS=gsk_your_first_key,gsk_your_second_key

# Optional overrides — default to Groq free-tier friendly models.
# GROQ_MODEL is used for answer composition; GROQ_EXTRACTION_MODEL for the
# faster entity-extraction classification step.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b

