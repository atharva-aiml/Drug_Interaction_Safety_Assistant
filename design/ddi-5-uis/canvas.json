  "annotations": [
    { "id": "note-clinical", "x": 0, "y": -170, "w": 640, "page": "dir-clinical", "text": "1. Clinical Signal Evolved\nThe product's existing graphite-and-cobalt palette, refined: IBM Plex type, quieter surfaces, severity kept strictly on its own warm ramp. Closest to today's app." },
    { "id": "note-warm", "x": 0, "y": -170, "w": 640, "page": "dir-warm", "text": "2. Human Warmth\nA patient-facing register: bone background, deep forest green, rounded pill controls and generous line-height, for someone anxious about their own medications." },
    { "id": "note-console", "x": 0, "y": -170, "w": 640, "page": "dir-console", "text": "3. Dark Console\nA dense, dark power tool for a pharmacist working fast: monospace data, hairline dividers, one cyan signal color reserved for live and active state." },
    { "id": "note-bold", "x": 0, "y": -170, "w": 640, "page": "dir-bold", "text": "4. Bold Modern\nAn energetic health-tech read: asymmetric hero, a right-hand context rail for the active risk, one saturated electric blue accent doing all the work." },
    { "id": "note-accessible", "x": 0, "y": -170, "w": 640, "page": "dir-accessible", "text": "5. Plain and Accessible\nLarge type, high contrast, one restrained blue accent, 44px+ targets throughout. Built for a busy pharmacist floor and for older patients alike." }
